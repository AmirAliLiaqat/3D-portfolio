# Node Server Port
PORT=5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://admin:admin123@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# JWT Auth Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Initial Admin Credentials (Auto created on first server run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
ADMIN_EMAIL=designstodeploy@gmail.com

# Cloudinary Integration (Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Nodemailer SMTP Configuration (Contact Form Email Notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=designstodeploy@gmail.com
SMTP_PASS=your_gmail_app_password
NOTIFICATION_EMAIL=designstodeploy@gmail.com

# Frontend API URL
VITE_API_URL=http://localhost:5000/api

# Groq AI (Portfolio AI Assistant Chat Widget)
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b
